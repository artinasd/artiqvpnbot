BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=your_telegram_numeric_admin_id
WEBHOOK_SECRET=your_random_telegram_webhook_secret

UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Existing Tunnel PasarGuard provider
PASARGUARD_BASE_URL=https://your-pasarguard-domain.example
PASARGUARD_API_KEY=your_pasarguard_panel_api_key
PASARGUARD_API_KEY_HEADER=X-Api-Key
PASARGUARD_TIMEOUT_MS=5000

# Gaming / PasarGuard Panel 2 provider (separate panel and credentials)
PASARGUARD_2_URL=https://your-second-pasarguard-domain.example
PASARGUARD_2_USERNAME=your_second_panel_admin_username
PASARGUARD_2_PASSWORD=your_second_panel_admin_password
PASARGUARD_2_TIMEOUT_MS=10000

# Direct / PasarGuard Panel 3 provider (separate panel and credentials)
PASARGUARD_DIRECT_URL=https://panel.zarinplus.net:8000
PASARGUARD_DIRECT_USERNAME=your_direct_panel_admin_username
PASARGUARD_DIRECT_PASSWORD=your_direct_panel_admin_password
PASARGUARD_DIRECT_TIMEOUT_MS=10000

# Direct 2 / separate PasarGuard web panel
PASARGUARD_DIRECT2_URL=https://admins.alizadehstore.ir:9901
PASARGUARD_DIRECT2_USERNAME=your_direct2_panel_admin_username
PASARGUARD_DIRECT2_PASSWORD=your_direct2_panel_admin_password
PASARGUARD_DIRECT2_TIMEOUT_MS=10000

SUPPORT_USERNAME=your_support_username
BANK_DETAILS=شماره کارت: ...\nبه نام: ...

TEST_TRAFFIC_GB=1
TEST_DURATION_DAYS=3
